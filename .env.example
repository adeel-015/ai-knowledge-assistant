# LLM provider: gemini | openai
LLM_PROVIDER=gemini

# API keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model configuration
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chroma configuration
# Leave empty (or set to memory) for in-process in-memory dev mode.
# Set an HTTP URL to use a running Chroma server.
CHROMA_URL=
CHROMA_COLLECTION_NAME=ai-knowledge-assistant
# Optional for Chroma Cloud/self-managed multi-tenant setups
CHROMA_TENANT=
CHROMA_DATABASE=
